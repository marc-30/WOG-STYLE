# =====================================================
# WOG-STYLE — Template variables d'environnement
# Copier vers .env.local et remplir les valeurs
# =====================================================

# Base de données MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=wog_database
DB_PORT=3306

# JWT — générer une valeur aléatoire longue en production
JWT_SECRET=

# Clé setup admin (POST /api/admin/setup)
ADMIN_SETUP_KEY=

# Vercel Blob Storage — upload images produits en production
# Obtenir sur : vercel.com → ton projet → Storage → Blob → Connect Store
BLOB_READ_WRITE_TOKEN=

# Stripe (optionnel — paiement carte désactivé si absent)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — email de notification de commande (obtenir sur resend.com/api-keys)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# KadevPay — agrégateur paiement Mobile Money + carte (pay.kadev.ci)
NEXT_PUBLIC_KADEVPAY_PUBLIC_KEY=
KADEVPAY_SECRET_KEY=
KADEVPAY_WEBHOOK_SECRET=
